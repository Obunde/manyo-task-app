
<div class="row justify-content-center">
  <div class="col-md-6">
    <h1><%= t('sessions.new.title') %></h1>

    <%= form_with(scope: :session, url: session_path, local: true) do |form| %>

      <div class="form-group">
        <%= form.label :email, t('sessions.new.email') %><br>
        <%= form.email_field :email, name: 'session[email]', class: 'form-control' %>
      </div>
                
      <div class="form-group">
        <%= form.label :password, t('common.password') %><br>
        <%= form.password_field :password, name: 'session[password]', class: 'form-control' %>
      </div>
                            
      <div class="text-right mt-4">
        <%= form.submit t('sessions.new.submit'), id: 'create-session', class: 'btn btn-primary px-4 mb-2' %>
      </div>
                                    
    <% end %>
  </div>
</div>
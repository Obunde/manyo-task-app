<h1>Login</h1>

<%= form_with(scope: :session, url: session_path, local: true) do |form| %>

  <div>
    <%= form.label :email, "Email address" %><br>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "Login" %>
  </div>

<% end %>
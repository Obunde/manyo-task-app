<%= form_with(model: user, local: true) do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% user.errors.values.flatten.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t('common.name') %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, t('common.email') %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, t('common.password') %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, t('common.password_confirmation') %>
    <%= form.password_field :password_confirmation %>
  </div>

  <% if user.new_record? %>
    <%= form.submit t('users.new.submit'), id: "create-user" %>
  <% else %>
    <%= form.submit t('users.edit.submit'), id: "update-user" %>
  <% end %>
<% end %>
<h1><%= t("admin.users.index.title") %></h1>

<table>
  <thead>
    <tr>
      <th><%= User.human_attribute_name(:name) %></th>
      <th><%= User.human_attribute_name(:email) %></th>
      <th><%= User.human_attribute_name(:admin) %></th>
      <th><%= t("admin.users.labels.task_count") %></th>
      <th><%= t("common.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.admin? ? t("admin.users.index.admin_yes") : t("admin.users.index.admin_no") %></td>
        <td><%= user.tasks.count %></td>
        <td>
          <%= link_to t("common.show"), admin_user_path(user), class: "show-user" %> |
          <%= link_to t("common.edit"), edit_admin_user_path(user), class: "edit-user" %> |
          <%= link_to t("common.delete"), admin_user_path(user),
                class: "destroy-user",
                method: :delete,
                data: { confirm: t("common.confirm_delete") } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
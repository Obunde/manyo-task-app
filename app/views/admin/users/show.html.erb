<h1><%= t("admin.users.show.title") %></h1>

<p><strong><%= User.human_attribute_name(:name) %>:</strong> <%= @user.name %></p>
<p><strong><%= User.human_attribute_name(:email) %>:</strong> <%= @user.email %></p>
<p><strong><%= User.human_attribute_name(:admin) %>:</strong> <%= @user.admin? ? t("admin.users.index.admin_yes") : t("admin.users.index.admin_no") %></p>
<p><strong><%= t("admin.users.labels.task_count") %>:</strong> <%= @user.tasks.count %></p>

<%= link_to t("common.edit"), edit_admin_user_path(@user) %> |
<%= link_to t("common.back"), admin_users_path %>
<h1><%= t("admin.users.show.title") %></h1>

<p><strong><%= t("activerecord.attributes.user.name") %>:</strong> <%= @user.name %></p>
<p><strong><%= t("activerecord.attributes.user.email") %>:</strong> <%= @user.email %></p>
<p><strong><%= t("activerecord.attributes.user.admin") %>:</strong> <%= @user.admin? ? t("admin.users.index.admin_yes") : t("admin.users.index.admin_no") %></p>
<p><strong><%= t("admin.users.labels.task_count") %>:</strong> <%= @user.tasks.count %></p>

<table>
  <thead>
    <tr>
      <th><%= t("activerecord.attributes.user.admin") %></th>
      <th><%= t('tasks.form.contents') %></th>
      <th><%= t('tasks.form.created_at') %></th>
      <th><%= t('tasks.form.deadline') %></th>
      <th><%= t('tasks.form.priority') %></th>
      <th><%= t('tasks.form.status') %></th>
    </tr>
  </thead>
  <tbody>
    <%# This now works because @tasks is defined in the controller! %>
    <% @tasks.each do |task| %>
      <tr>
        <td class="task-title"><%= task.title %></td>
        <td class="task-content"><%= task.content %></td>
        <td class="task-created-at"><%= task.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td class="task-deadline"><%= task.deadline_on.strftime("%Y/%m/%d") %></td>
        <td class="task-priority"><%= t("tasks.priority.#{task.priority}") %></td>
        <td class="task-status"><%= t("tasks.status.#{task.status}") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @tasks %>

<%= link_to t("common.edit"), edit_admin_user_path(@user) %> |
<%= link_to t("common.back"), admin_users_path %>
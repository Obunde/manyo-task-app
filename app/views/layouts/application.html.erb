<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <nav>
      <% if logged_in? %>
        <% if current_user.admin? %>
            <%= link_to t('global.admin'), admin_users_path, id: 'users-index' %>
            <%= link_to t('global.new_user'), new_admin_user_path, id: 'add-user' %>
        <% end %>
        <%= link_to t('global.task_list'), tasks_path, id: 'tasks-index' %>
        <%= link_to t('global.new_task'), new_task_path, id: 'new-task' %>
        <%= link_to t('global.profile'), user_path(current_user), id: 'account-setting' %> |
        <%= link_to t('global.logout'), session_path, method: :delete, id: 'sign-out' %> 
      <% else %>
        <%= link_to t('global.login'), new_session_path, id: 'sign-in' %> |
        <%= link_to t('global.sign_up'), new_user_path, id: 'sign-up' %>
      <% end %>

    </nav>

    <% if notice %>
      <p><%= notice %></p>
    <% end %>

    <% if alert %>
      <p><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>

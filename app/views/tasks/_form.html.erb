<%= form_with(model: task, local: true) do |form| %>
  <div>
    <%= form.label :title, t('tasks.form.title') %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, t('tasks.form.contents') %>
    <%= form.text_area :content %>
  </div>

   <div>
    <%= form.label :deadline_on, t('tasks.form.deadline') %>
    <%= form.date_field :deadline_on %>
  </div>

   <div>
    <%= form.label :priority, t('tasks.form.priority') %>
    <%= form.select :priority, options_for_select(Task.priorities.keys.map { |key| [t("tasks.priority.#{key}"), key] }, task.priority), {include_blank: true} %>
  </div>

   <div>
    <%= form.label :status, t('tasks.form.status') %>
    <%= form.select :status, options_for_select(Task.statuses.keys.map { |key| [t("tasks.status.#{key}"), key] }, task.status), {include_blank: true} %>
  </div>

  <div>
    <%= form.submit submit_text, id: submit_id %>
  </div>
<% end %>

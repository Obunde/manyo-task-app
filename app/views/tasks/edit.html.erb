<h1><%= t('tasks.edit.title') %></h1>

<% if @task.errors.any? %>
  <div id="error_explanation">
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= render 'form',
           task: @task,
           submit_text: t('tasks.edit.submit'),
           submit_id: 'update-task' %>

<%= link_to t('common.back'), tasks_path, id: 'back' %>

<h1>Show Task Page</h1>

<p>
  <strong>Title:</strong>
  <%= @task.title %>
</p>

<p>
  <strong>Content:</strong>
  <%= @task.content %>
</p>

<p>
  <strong>Created_at:</strong>
  <%= @task.created_at.strftime("%Y-%m-%d %H:%M") %>
</p>

<%= link_to 'Edit', edit_task_path(@task), id: 'edit-task' %> |

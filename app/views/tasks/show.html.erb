<h1><%= t("tasks.show.title") %></h1>

<p>
  <strong><%= t("tasks.form.title") %>:</strong>
  <span id="title"><%= @task.title %></span>
</p>

<p>
  <strong><%= t("tasks.form.contents") %>:</strong>
  <span id="content"><%= @task.content %></span>
</p>

<p>
  <strong><%= t("tasks.form.created_at") %>:</strong>
  <span id="created-at"><%= @task.created_at.strftime("%Y/%m/%d %H:%M") %></span>
</p>

<p>
  <strong><%= t("tasks.form.deadline") %>:</strong>
  <span id="deadline-on"><%= @task.deadline_on.strftime("%Y/%m/%d") %></span>
</p>

<p>
  <strong><%= t("tasks.form.priority") %>:</strong>
  <span id="priority"><%= t("tasks.priority.#{@task.priority}") %></span>
</p>

<p>
  <strong><%= t("tasks.form.status") %>:</strong>
  <span id="status"><%= t("tasks.status.#{@task.status}") %></span>
</p>

<p>
  <strong><%= t("tasks.form.labels") %>:</strong>
  <span id="labels">
    <% @task.labels.each do |label| %>
      <%= label.name %><% unless label == @task.labels.last %>, <% end %>
    <% end %>
  </span>
</p>


<%= link_to t('common.edit'), edit_task_path(@task), id: 'edit-task' %> |
<%= link_to t('common.back'), tasks_path, id: 'back' %>

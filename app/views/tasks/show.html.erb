<h1>Show Task Page</h1>

<p>
  <strong>Title:</strong>
  <span id="title"><%= @task.title %></span>
</p>

<p>
  <strong>Content:</strong>
  <span id="content"><%= @task.content %></span>
</p>

<p>
  <strong>Created at:</strong>
  <span id="created-at"><%= @task.created_at.strftime("%Y-%m-%d %H:%M") %></span>
</p>


<%= link_to 'Edit', edit_task_path(@task), id: 'edit-task' %> |

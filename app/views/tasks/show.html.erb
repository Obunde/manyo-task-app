<h1><%= t("tasks.show.title") %></h1>

<p>
  <strong><%= t("tasks.form.title") %>:</strong>
  <span id="title"><%= @task.title %></span>
</p>

<p>
  <strong><%= t("tasks.form.contents") %>:</strong>
  <span id="content"><%= @task.content %></span>
</p>

<p>
  <strong><%= t("tasks.form.created_at") %>:</strong>
  <span id="created-at"><%= @task.created_at.strftime("%Y/%m/%d %H:%M") %></span>
</p>


<%= link_to t('common.edit'), edit_task_path(@task), id: 'edit-task' %> |
<%= link_to t('common.back'), tasks_path, id: 'back' %>

<h1>Tasks Index Page</h1>

<table>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td class="task-title"><%= task.title %></td>
        <td class="task-content"><%= task.content %></td>
        <td class="task-created-at"><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td>
          <%= link_to 'Show', task_path(task), class: 'show-task' %> |
          <%= link_to 'Edit', edit_task_path(task), class: 'edit-task' %> |
          <%= link_to 'Destroy', task_path(task), method: :delete, data: { confirm: 'Are you sure?' }, class: 'destroy-task' %>
        </td>
      </tr>
    <% end %>
  </tbody>

</table>



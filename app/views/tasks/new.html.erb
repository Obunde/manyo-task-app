<h1>New Task Page</h1>

<% if @task.errors.any? %>
  <div id="error_explanation">
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= render 'form',
           task: @task,
           submit_text: 'Create Task',
           submit_id: 'create-task' %>

<%= link_to 'Back', tasks_path, id: 'back' %>

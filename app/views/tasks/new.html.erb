
<div class="row justify-content-center">
  <div class="col-md-6">
        <h1><%= t('tasks.new.title') %></h1>
  </div>
</div>

<% if @task.errors.any? %>
  <div id="error_explanation">
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= render 'form',
           task: @task,
           submit_text: t('tasks.new.submit'),
           submit_id: 'create-task' %>

<%= link_to t('common.back'), tasks_path, id: 'back' %>
